{
  "name": "agy-plugin-dailynote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily Notes (每日笔记) Antigravity plugin pnpm monorepo.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Neonity2020/agy-plugin-dailynote.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "typecheck": "pnpm --filter @daily-notes/plugin typecheck && pnpm --filter @daily-notes/marketing check",
    "build": "pnpm --filter @daily-notes/plugin build && pnpm --filter @daily-notes/marketing build",
    "build:plugin": "pnpm --filter @daily-notes/plugin build",
    "build:marketing": "pnpm --filter @daily-notes/marketing build",
    "test": "pnpm --filter @daily-notes/core test && pnpm --filter @daily-notes/plugin test",
    "test:core": "pnpm --filter @daily-notes/core test",
    "test:plugin": "pnpm --filter @daily-notes/plugin test",
    "dev:sidecar": "pnpm --filter @daily-notes/plugin dev:sidecar",
    "dev:web": "pnpm --filter @daily-notes/plugin dev:web",
    "dev:marketing": "pnpm --filter @daily-notes/marketing dev"
  }
}
