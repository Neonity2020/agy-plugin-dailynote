---
import Icon from './Icon.astro';
import type { IconName } from '../icons';

const features: {
  icon: IconName;
  title: string;
  body: string;
  visual: string;
  span?: string;
}[] = [
  {
    icon: 'code',
    title: '所见即所得，也给你源码',
    body: 'Tiptap 富文本与纯 Markdown 源码双向无损切换。日常像 Notion 一样写，交付前切到源码做精确微调。',
    visual: 'editor',
    span: 'wide',
  },
  {
    icon: 'search',
    title: '中英文全文检索',
    body: 'SQLite FTS5 trigram + 1–2 字降级匹配，关键词、#标签、项目名都能毫秒级命中并高亮片段。',
    visual: 'search',
  },
  {
    icon: 'check',
    title: '待办是真的能勾的',
    body: '输入 - [ ] 立刻变成可点击复选框，自动统计完成度，昨日未完成项可一键幂等顺延。',
    visual: 'tasks',
  },
  {
    icon: 'hash',
    title: '标签与日期双链',
    body: '正文里的 #标签 自动建索引；[[2026-11-24]] 渲染成胶囊，点击即刻回到那一天的上下文。',
    visual: 'link',
  },
  {
    icon: 'image',
    title: '截图直接粘贴',
    body: 'Cmd+V 或拖拽图片即落盘到本地 attachments/，缩略预览、点击放大，不经过任何图床。',
    visual: 'image',
  },
  {
    icon: 'file',
    title: '复制 / 导出 Markdown',
    body: '一键复制标准 GFM 文本或导出 YYYY-MM-DD.md，日报、存档、丢进任何编辑器都不掉格式。',
    visual: 'export',
    span: 'wide',
  },
];
---

<section class="section features" id="features">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Inside the editor</p>
      <h2 class="section-title">窄栏里的完整编辑器，<span class="grad">不缩水。</span></h2>
      <p class="section-lead">
        所有能力都为 320–480px 的辅助侧边栏重新排过：键盘优先、零横向溢出、暗色原生融合。
        选中文字有悬浮工具栏，空行敲 <code>/</code> 唤起块菜单。
      </p>
    </div>

    <div class="bento">
      {
        features.map((feature, index) => (
          <article
            class:list={['card feature', feature.span === 'wide' && 'feature-wide']}
            data-reveal
            data-reveal-delay={index * 60}
          >
            <div class="feature-top">
              <span class="feature-icon"><Icon name={feature.icon} size={19} /></span>
              <span class="feature-num">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>

            {feature.visual === 'editor' && (
              <div class="demo demo-editor" aria-hidden="true">
                <div class="demo-toolbar">
                  <b>B</b><i>I</i><s>S</s><span class="tb-code">&lt;/&gt;</span>
                  <span class="tb-send">发送到对话</span>
                  <span class="tb-toggle">WYSIWYG / MD</span>
                </div>
                <p class="demo-h1">今日目标</p>
                <p class="demo-line">
                  <span class="demo-box demo-done">✓</span> 对齐 <code>sidecar_sdk</code> 接口契约
                </p>
                <p class="demo-line">
                  <span class="demo-box" /> 补全 <mark>WAL 并发</mark> 回归用例
                  <span class="demo-tag">#backend</span>
                </p>
              </div>
            )}

            {feature.visual === 'search' && (
              <div class="demo demo-search" aria-hidden="true">
                <span class="search-field"><Icon name="search" size={12} /> trigram</span>
                <span class="search-hit">11-24 · <mark>trigram</mark> 索引命中测试</span>
                <span class="search-hit">11-21 · SQLite FTS5 <mark>trigram</mark> 方案</span>
              </div>
            )}

            {feature.visual === 'tasks' && (
              <div class="demo demo-tasks" aria-hidden="true">
                <span><i class="demo-box demo-done">✓</i> 插件加载</span>
                <span><i class="demo-box" /> Markdown 渲染</span>
                <span><i class="demo-box" /> 待确认插件名称</span>
                <em>2 / 3 已完成</em>
              </div>
            )}

            {feature.visual === 'link' && (
              <div class="demo demo-link" aria-hidden="true">
                <span class="wikilink">[[2026-11-24]]</span>
                <span class="demo-tag">#sidebar</span>
                <span class="demo-tag">#发布前检查</span>
              </div>
            )}

            {feature.visual === 'image' && (
              <div class="demo demo-image" aria-hidden="true">
                <span class="thumb thumb-a" />
                <span class="thumb thumb-b" />
                <span class="thumb thumb-c">+</span>
              </div>
            )}

            {feature.visual === 'export' && (
              <div class="demo demo-export" aria-hidden="true">
                <span class="export-file"><Icon name="file" size={13} /> 2026-11-25.md</span>
                <span class="export-ok"><Icon name="check" size={12} /> 已导出</span>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    border-top: 1px solid var(--line);
  }

  .section-lead code {
    font-family: var(--mono);
    font-size: 0.9em;
    color: var(--blue-2);
    background: var(--blue-soft);
    padding: 1px 5px;
    border-radius: 3px;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .feature {
    display: flex;
    flex-direction: column;
    padding: 24px;
    min-height: 262px;
    transition:
      border-color 0.25s,
      transform 0.25s,
      background 0.25s;
  }

  .feature:hover {
    border-color: rgba(147, 197, 253, 0.32);
    transform: translateY(-3px);
  }

  .feature-wide {
    grid-column: span 2;
  }

  .feature-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .feature-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid rgba(147, 197, 253, 0.22);
    background: var(--blue-soft);
    color: var(--blue-2);
  }

  .feature-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.1em;
  }

  .feature h3 {
    margin-top: 20px;
    font-size: 17.5px;
    font-weight: 620;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .feature > p {
    margin-top: 9px;
    color: var(--muted);
    font-size: 13.8px;
    line-height: 1.68;
  }

  .demo {
    margin-top: auto;
    padding-top: 20px;
    font-size: 11.5px;
    color: var(--fg-2);
  }

  .demo code {
    font-family: var(--mono);
    font-size: 0.92em;
    color: var(--blue-2);
  }

  .demo-toolbar {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px 8px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: rgba(0, 0, 0, 0.35);
    color: var(--muted);
    font-size: 10px;
  }

  .demo-toolbar b,
  .demo-toolbar i,
  .demo-toolbar s {
    color: var(--fg-2);
    font-weight: 600;
  }

  .tb-code {
    font-family: var(--mono);
    font-size: 9px;
  }

  .tb-send {
    margin-left: auto;
    color: var(--blue-2);
    white-space: nowrap;
  }

  .tb-toggle {
    font-family: var(--mono);
    font-size: 8px;
    padding: 2px 5px;
    border: 1px solid var(--line);
    border-radius: 4px;
    white-space: nowrap;
  }

  .demo-h1 {
    margin-top: 12px;
    font-size: 13px;
    font-weight: 650;
    color: var(--fg);
  }

  .demo-line {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 6px;
    flex-wrap: wrap;
  }

  .demo-box {
    display: inline-grid;
    place-items: center;
    width: 12px;
    height: 12px;
    border-radius: 3px;
    border: 1.4px solid #5c6472;
    font-style: normal;
    font-size: 8px;
    flex: none;
  }

  .demo-done {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }

  .demo-tag {
    font-size: 9.5px;
    padding: 1px 5px;
    border-radius: 3px;
    background: var(--blue-soft);
    color: var(--blue-2);
    font-family: var(--mono);
  }

  mark {
    background: rgba(250, 204, 21, 0.26);
    color: #fde68a;
    padding: 0 2px;
    border-radius: 2px;
  }

  .demo-search {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .search-field {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    color: var(--faint);
    font-family: var(--mono);
    font-size: 10px;
  }

  .search-hit {
    font-size: 10.5px;
    color: var(--muted);
    padding: 4px 7px;
    border-left: 2px solid var(--line-strong);
  }

  .demo-tasks {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 11px;
  }

  .demo-tasks > span {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .demo-tasks em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--faint);
    margin-top: 2px;
  }

  .demo-link {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .wikilink {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--blue-2);
    background: var(--blue-soft);
    border: 1px solid rgba(96, 165, 250, 0.34);
    border-radius: 4px;
    padding: 2px 6px;
  }

  .demo-image {
    display: flex;
    gap: 7px;
  }

  .thumb {
    width: 48px;
    height: 36px;
    border-radius: 5px;
    border: 1px solid var(--line);
    background:
      linear-gradient(135deg, rgba(59, 130, 246, 0.32), rgba(167, 139, 250, 0.22)),
      repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.06) 0 3px, transparent 3px 6px);
  }

  .thumb-b {
    background:
      linear-gradient(135deg, rgba(109, 179, 93, 0.3), rgba(59, 130, 246, 0.2)),
      repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.06) 0 3px, transparent 3px 6px);
  }

  .thumb-c {
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.03);
    color: var(--faint);
    font-size: 15px;
  }

  .demo-export {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 10px;
    border: 1px dashed var(--line-strong);
    border-radius: 7px;
    font-family: var(--mono);
  }

  .export-file {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--fg-2);
    font-size: 10.5px;
  }

  .export-ok {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--green);
    font-size: 9.5px;
    white-space: nowrap;
  }

  @media (max-width: 980px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .bento {
      grid-template-columns: 1fr;
    }

    .feature-wide {
      grid-column: auto;
    }

    .feature {
      min-height: 0;
      padding: 22px;
    }

    .demo {
      margin-top: 18px;
    }
  }
</style>
