---
import Icon from './Icon.astro';
import { DOWNLOAD_URL, ISSUES_URL, MIN_NODE, RELEASES_URL, REPO_NAME, REPO_URL, VERSION } from '../config';

const steps = [
  {
    title: '获取源码',
    body: '克隆仓库或直接下载 ZIP 解压；没有 Git 也能装。',
    commands: [`git clone ${REPO_URL}.git`, `cd ${REPO_NAME}`],
  },
  {
    title: '安装依赖并构建',
    body: '通过 pnpm workspace 编译侧边栏前端，并把 Sidecar 与 MCP Server 打包成零依赖独立文件。',
    commands: ['pnpm install', 'pnpm build:plugin'],
  },
  {
    title: '校验并安装插件',
    body: '严格模式校验 packages/plugin 清单，通过后安装到本地 Antigravity 插件目录。',
    commands: ['agy plugin validate --strict ./packages/plugin', 'agy plugin install ./packages/plugin'],
  },
];
---

<section class="section install" id="install">
  <div class="container">
    <div class="install-head">
      <div data-reveal>
        <p class="eyebrow">Three commands</p>
        <h2 class="section-title">三分钟，装进侧边栏。</h2>
        <p class="section-lead">
          需要 Node.js <strong>≥ {MIN_NODE}</strong>（原生 <code>node:sqlite</code> 与 FTS5 trigram）与
          Antigravity 客户端。全程本地构建，不上传任何代码。
        </p>
      </div>

      <a
        class="download-alt card"
        href={DOWNLOAD_URL}
        target="_blank"
        rel="noopener noreferrer"
        data-reveal
        data-reveal-delay="80"
      >
        <span class="download-icon"><Icon name="download" size={20} /></span>
        <span>
          <strong>不想用 Git？</strong>
          <em>下载 ZIP 后解压，从第 2 步开始</em>
        </span>
        <Icon name="arrow" size={16} />
      </a>
    </div>

    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step card" data-reveal data-reveal-delay={index * 90}>
            <span class="step-num">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <div class="step-cmds">
              {step.commands.map((command) => (
                <div class="cmd">
                  <span class="cmd-prefix">$</span>
                  <code>{command}</code>
                  <button
                    class="cmd-copy"
                    type="button"
                    data-copy={command}
                    aria-label={`复制命令：${command}`}
                  >
                    <Icon name="copy" size={13} />
                    <span data-copy-label>复制</span>
                  </button>
                </div>
              ))}
            </div>
          </li>
        ))
      }
    </ol>

    <div class="after" data-reveal>
      <div class="after-main">
        <span class="after-icon"><Icon name="package" size={18} /></span>
        <p>
          安装完成后，在 Antigravity 中打开<strong>辅助侧边栏（Auxiliary Side Pane）</strong>，
          选择「每日笔记」即可开始书写。插件版本 <span class="mono">v{VERSION}</span>。
        </p>
      </div>
      <div class="after-links">
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer"><Icon name="github" size={14} /> 仓库</a>
        <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer"><Icon name="package" size={14} /> 版本发布</a>
        <a href={ISSUES_URL} target="_blank" rel="noopener noreferrer"><Icon name="arrow" size={14} /> 反馈问题</a>
      </div>
    </div>
  </div>
</section>

<style>
  .install {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(720px 420px at 20% 0%, rgba(37, 99, 235, 0.1), transparent 70%),
      transparent;
  }

  .install-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: clamp(36px, 5vw, 52px);
  }

  .section-lead code {
    font-family: var(--mono);
    font-size: 0.9em;
    color: var(--blue-2);
    background: var(--blue-soft);
    padding: 1px 5px;
    border-radius: 3px;
  }

  .download-alt {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 14px 16px;
    max-width: 360px;
    transition:
      border-color 0.2s,
      background 0.2s;
  }

  .download-alt:hover {
    border-color: rgba(147, 197, 253, 0.36);
    background: rgba(59, 130, 246, 0.07);
  }

  .download-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 9px;
    background: var(--blue-soft);
    color: var(--blue-2);
  }

  .download-alt strong {
    display: block;
    font-size: 13.5px;
  }

  .download-alt em {
    display: block;
    font-style: normal;
    font-size: 11.5px;
    color: var(--muted);
    margin-top: 2px;
  }

  .download-alt > svg {
    margin-left: auto;
    color: var(--faint);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    counter-reset: none;
  }

  .step {
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  .step-num {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--blue-2);
  }

  .step h3 {
    margin-top: 12px;
    font-size: 18px;
    font-weight: 620;
    letter-spacing: -0.02em;
  }

  .step > p {
    margin-top: 7px;
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.65;
    min-height: 44px;
  }

  .step-cmds {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: auto;
    padding-top: 18px;
  }

  .cmd {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 6px;
    background: #080a0e;
    border: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    overflow: hidden;
  }

  .cmd-prefix {
    color: var(--faint);
    flex: none;
    line-height: 1.7;
  }

  .cmd code {
    flex: 1;
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
    line-height: 1.7;
    color: var(--fg-2);
  }

  .cmd-copy {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: none;
    padding: 3px 6px;
    border-radius: 4px;
    font-family: var(--font);
    font-size: 10px;
    color: var(--faint);
    border: 1px solid var(--line);
  }

  .cmd-copy:hover,
  .cmd-copy[data-copied] {
    color: var(--blue-2);
    border-color: rgba(96, 165, 250, 0.4);
  }

  .after {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 22px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.02);
  }

  .after-main {
    display: flex;
    align-items: center;
    gap: 13px;
    max-width: 62ch;
  }

  .after-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 9px;
    border: 1px solid var(--line);
    color: var(--green);
  }

  .after-main p {
    font-size: 13.5px;
    color: var(--muted);
  }

  .after-main strong {
    color: var(--fg);
  }

  .mono {
    font-family: var(--mono);
    font-size: 0.92em;
    color: var(--blue-2);
  }

  .after-links {
    display: flex;
    gap: 8px;
  }

  .after-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 11px;
    border-radius: 6px;
    border: 1px solid var(--line);
    font-size: 12px;
    color: var(--fg-2);
  }

  .after-links a:hover {
    border-color: var(--line-strong);
    color: var(--fg);
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .step > p {
      min-height: 0;
    }

    .step-cmds {
      padding-top: 14px;
    }
  }

  @media (max-width: 560px) {
    .download-alt {
      max-width: none;
      width: 100%;
    }

    .after {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
