---
import Icon from './Icon.astro';
import { REPO_URL, VERSION } from '../config';
---

<header class="nav" data-header>
  <div class="nav-inner container">
    <a class="brand" href="/" aria-label="Daily Notes 首页">
      <img src="/logo.svg" alt="" width="30" height="30" />
      <span class="brand-name">Daily Notes</span>
      <span class="brand-version">v{VERSION}</span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      <a href="#features">功能</a>
      <a href="#agent">AI 协同</a>
      <a href="#privacy">隐私</a>
      <a href="#install">安装</a>
      <a href="#faq">FAQ</a>
    </nav>

    <div class="nav-actions">
      <a class="btn btn-primary btn-sm" href={REPO_URL} target="_blank" rel="noopener noreferrer">
        <Icon name="github" size={16} />
        GitHub
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu>
    <a href="#features">功能</a>
    <a href="#agent">AI 协同</a>
    <a href="#privacy">隐私</a>
    <a href="#install">安装</a>
    <a href="#faq">FAQ</a>
    <a class="mobile-cta" href={REPO_URL} target="_blank" rel="noopener noreferrer">
      <Icon name="github" size={17} /> 前往 GitHub 下载
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      backdrop-filter 0.25s ease;
  }

  .nav[data-scrolled] {
    background: rgba(7, 8, 11, 0.78);
    border-bottom-color: var(--line);
    backdrop-filter: blur(16px) saturate(1.3);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 72px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }

  .brand img {
    border-radius: 7px;
    box-shadow: 0 0 0 1px var(--line);
  }

  .brand-name {
    font-weight: 650;
    letter-spacing: -0.02em;
    font-size: 15.5px;
  }

  .brand-version {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--muted);
    padding: 2px 7px;
    border: 1px solid var(--line);
    border-radius: 999px;
    line-height: 1.5;
  }

  .nav-links {
    display: flex;
    gap: 4px;
    margin-inline: auto;
  }

  .nav-links a {
    padding: 8px 13px;
    border-radius: 7px;
    font-size: 14px;
    color: var(--fg-2);
    transition:
      color 0.16s,
      background 0.16s;
  }

  .nav-links a:hover {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.055);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }

  .menu-toggle {
    display: none;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .menu-toggle span {
    width: 16px;
    height: 1.5px;
    background: var(--fg);
    transition: transform 0.2s;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .mobile-menu {
      display: none;
      flex-direction: column;
      gap: 2px;
      padding: 8px 18px 18px;
      border-bottom: 1px solid var(--line);
      background: rgba(7, 8, 11, 0.97);
      backdrop-filter: blur(16px);
    }

    .mobile-menu[data-open] {
      display: flex;
    }

    .mobile-menu a {
      padding: 12px 4px;
      font-size: 15px;
      color: var(--fg-2);
      border-bottom: 1px solid var(--line);
    }

    .mobile-menu .mobile-cta {
      margin-top: 12px;
      border: 0;
      border-radius: 8px;
      background: var(--blue);
      color: #fff;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-weight: 600;
    }

    .nav-actions .btn {
      display: none;
    }
  }
</style>
