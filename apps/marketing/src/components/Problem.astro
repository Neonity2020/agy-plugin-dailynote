---
const problems = [
  {
    kicker: '01 / 心流',
    title: '切到外部笔记，思路就断了',
    body: '打开另一个应用、挑一个文件、想一个标题——等落笔时，刚才那段推理已经凉了。',
  },
  {
    kicker: '02 / 待办',
    title: '没做完的事，散落在聊天记录里',
    body: '“明天接着看”的排查项、接口约定、验证步骤，被新的对话一轮轮冲走，回头翻找成本极高。',
  },
  {
    kicker: '03 / 重量',
    title: '知识库工具在窄栏里太笨重',
    body: '文件夹树、页面层级、模板管理器……你只想要今天这一页，却要先做一堆组织工作。',
  },
];
---

<section class="section problem">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">The everyday friction</p>
      <h2 class="section-title">记录，不该以<br />打断开发为代价。</h2>
    </div>

    <div class="problem-grid">
      {
        problems.map((item, index) => (
          <article class="problem-item" data-reveal data-reveal-delay={index * 90}>
            <p class="problem-kicker">{item.kicker}</p>
            <h3>{item.title}</h3>
            <p class="problem-body">{item.body}</p>
          </article>
        ))
      }
    </div>

    <p class="problem-answer" data-reveal>
      Daily Notes 只做一件事：让你在正在编码的那块屏幕里，
      <span class="hl">用一次点击开始记录，用零次切换完成记录。</span>
    </p>
  </div>
</section>

<style>
  .problem {
    border-top: 1px solid var(--line);
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border-block: 1px solid var(--line);
  }

  .problem-item {
    padding: 30px 28px 34px;
    background: var(--ink);
  }

  .problem-kicker {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--faint);
    text-transform: uppercase;
  }

  .problem-item h3 {
    margin-top: 16px;
    font-size: 19px;
    font-weight: 620;
    letter-spacing: -0.02em;
    line-height: 1.4;
    color: var(--fg);
  }

  .problem-body {
    margin-top: 12px;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.72;
  }

  .problem-answer {
    margin-top: clamp(36px, 5vw, 56px);
    max-width: 34ch;
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.42;
    letter-spacing: -0.03em;
    font-weight: 560;
    color: var(--fg-2);
  }

  .hl {
    color: var(--blue-2);
  }

  @media (max-width: 860px) {
    .problem-grid {
      grid-template-columns: 1fr;
    }

    .problem-answer {
      max-width: 42ch;
    }
  }
</style>
