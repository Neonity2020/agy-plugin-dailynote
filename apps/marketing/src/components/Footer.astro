---
import Icon from './Icon.astro';
import { ISSUES_URL, REPO_SLUG, REPO_URL, VERSION } from '../config';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src="/logo.svg" alt="" width="26" height="26" />
      <div>
        <p class="footer-name">Daily Notes <span>v{VERSION}</span></p>
        <p class="footer-desc">Antigravity 辅助侧边栏里的本地优先每日笔记。</p>
      </div>
    </div>

    <nav class="footer-nav" aria-label="页脚导航">
      <a href="#features">功能</a>
      <a href="#agent">AI 协同</a>
      <a href="#privacy">隐私</a>
      <a href="#install">安装</a>
      <a href="#faq">FAQ</a>
    </nav>

    <div class="footer-links">
      <a href={REPO_URL} target="_blank" rel="noopener noreferrer" aria-label="GitHub 仓库">
        <Icon name="github" size={17} />
      </a>
      <a href={ISSUES_URL} target="_blank" rel="noopener noreferrer" aria-label="问题反馈">
        <Icon name="arrow" size={17} />
      </a>
    </div>
  </div>

  <div class="container footer-base">
    <p>© {year} Daily Notes · MIT License · 非 Google 官方产品</p>
    <p class="footer-repo">github.com/{REPO_SLUG}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-top: 44px;
    padding-bottom: 34px;
  }

  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
  }

  .footer-brand {
    display: flex;
    gap: 11px;
    align-items: flex-start;
  }

  .footer-brand img {
    border-radius: 6px;
  }

  .footer-name {
    font-size: 14px;
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .footer-name span {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--faint);
    margin-left: 4px;
  }

  .footer-desc {
    margin-top: 3px;
    font-size: 12px;
    color: var(--faint);
    max-width: 34ch;
  }

  .footer-nav {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--muted);
    padding-top: 3px;
  }

  .footer-nav a:hover {
    color: var(--fg);
  }

  .footer-links {
    display: flex;
    gap: 8px;
  }

  .footer-links a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--muted);
    transition:
      color 0.16s,
      border-color 0.16s;
  }

  .footer-links a:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }

  .footer-base {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 38px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    color: var(--faint);
  }

  .footer-repo {
    font-family: var(--mono);
    letter-spacing: 0.02em;
  }

  @media (max-width: 720px) {
    .footer-nav {
      order: 3;
      width: 100%;
    }
  }
</style>
